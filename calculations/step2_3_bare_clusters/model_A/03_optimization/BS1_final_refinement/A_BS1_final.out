end

basis spherical
    * library def2-svp
end

dft
    odft
    mult 1
    xc becke88 perdew86

    iterations 150

    convergence fast energy 1e-5 density 1e-4 gradient 1e-3

    vectors input start.movecs output A_BS1_final.movecs

    mulliken
end

driver
    default
    maxiter 30
    xyz A_BS1_final
end

